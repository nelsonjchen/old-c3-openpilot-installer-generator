{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "c3op-installer-generator",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-21",
  "account_id": "c455dc5b9661861484370320794ab63c",
  "routes": [
    {
      "pattern": "c3op.mindflakes.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".worker-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
